generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SiteInformation {
  id          Int      @id @default(autoincrement())
  name        String?
  logo        String?
  description String?  @db.MediumText
  url         String?
  address     String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phone1      String?
  phone2      String?
  email1      String?
  email2      String?
  facebook    String?
  twitter     String?
  instagram   String?
  linkedin    String?
  youtube     String?
  whatsapp    String?
  openingTime String?
  footerAbout String?
  embedVideo  String?  @db.MediumText
}

model Media {
  id           Int           @id @default(autoincrement())
  alt          String?
  original     String?
  thumbnail    String?
  phone        String?
  type         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  packageId    Int?
  activities   Activity[]
  author       Author[]
  blogs        Blog[]
  carousel     Carousel[]
  destinations Destination[]
  mail         Mail[]
  packageMain  Package[]     @relation("PackageMainImage")
  map          Package[]     @relation("PackageMap")
  reviews      Review[]
  seo          Seo[]
  team         Team[]
  payment      Payment[]
  packages     Package[]     @relation("mediaPackages")
}

model Review {
  id          Int      @id @default(autoincrement())
  description String?  @db.MediumText
  name        String?
  title       String?
  rating      Int?     @default(5)
  packageId   Int?
  reviewDate  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mediaId     Int?
  media       Media?   @relation(fields: [mediaId], references: [id])
  package     Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([mediaId], map: "Review_mediaId_fkey")
  @@index([packageId], map: "Review_packageId_fkey")
}

model User {
  id         Int        @id @default(autoincrement())
  name       String?
  email      String     @unique
  role       Role       @default(USER)
  country    String?
  phone      String?
  isVerified Boolean?
  otp        String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now())
  wishlists  Wishlist[]
}

model Carousel {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?  @db.MediumText
  subtitle    String?
  link        String?
  page        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mediaId     Int?
  media       Media?   @relation(fields: [mediaId], references: [id])

  @@index([mediaId], map: "Carousel_mediaId_fkey")
}

model Blog {
  id          Int       @id @default(autoincrement())
  title       String?
  description String?   @db.MediumText
  content     String?   @db.LongText
  slug        String    @unique
  subtitle    String?
  link        String?
  page        String?
  seoId       Int?      @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    Int?
  publisher   String?
  isPublished Boolean?  @default(true)
  mediaId     Int?
  author      Author?   @relation(fields: [authorId], references: [id])
  media       Media?    @relation(fields: [mediaId], references: [id])
  seo         Seo?      @relation(fields: [seoId], references: [id])
  comments    Comment[]

  @@index([authorId], map: "Blog_authorId_fkey")
  @@index([mediaId], map: "Blog_mediaId_fkey")
}

model Seo {
  id              Int          @id @default(autoincrement())
  metaTitle       String?
  metaDescription String?      @db.MediumText
  metaKeywords    String?      @db.MediumText
  mediaId         Int?
  metaCanonical   String?
  schema          String?      @db.MediumText
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  authorId        Int?         @unique
  activity        Activity?
  author          Author?
  blog            Blog?
  category        Category?
  destination     Destination?
  package         Package?
  media           Media?       @relation(fields: [mediaId], references: [id])

  @@index([mediaId], map: "Seo_mediaId_fkey")
}

model Activity {
  id           Int           @id @default(autoincrement())
  name         String?
  description  String?
  slug         String?       @unique
  createdAt    DateTime      @default(now())
  seoId        Int?          @unique
  mediaId      Int?
  media        Media?        @relation(fields: [mediaId], references: [id])
  seo          Seo?          @relation(fields: [seoId], references: [id])
  destinations Destination[]

  @@index([mediaId], map: "Activity_mediaId_fkey")
}

model Destination {
  id          Int       @id @default(autoincrement())
  name        String?
  slug        String?   @unique
  description String?
  activityId  Int
  createdAt   DateTime  @default(now())
  seoId       Int?      @unique
  mediaId     Int?
  activity    Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  media       Media?    @relation(fields: [mediaId], references: [id])
  seo         Seo?      @relation(fields: [seoId], references: [id])
  packages    Package[]

  @@index([activityId], map: "Destination_activityId_fkey")
  @@index([mediaId], map: "Destination_mediaId_fkey")
}

model Package {
  id            Int         @id @default(autoincrement())
  title         String?
  description   String?     @db.LongText
  accommodation String?
  startFrom     String?
  endAt         String?
  duration      String?
  slug          String      @unique
  subtitle      String?
  altitude      String?
  bestSeason    String?
  price         String?
  videoLink     String?     @db.MediumText
  rating        Int?        @default(5)
  culture       String?
  attractions   String?
  groupSize     String?
  groupAge      String?
  nature        String?
  activity      String?
  overview      String?     @db.LongText
  itinerary     String?     @db.LongText
  includes      String?     @db.LongText
  goodtoknow    String?     @db.LongText
  highlights    String?     @db.LongText
  mapId         Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  seoId         Int?        @unique
  destinationId Int
  mainImageId   Int?
  Booking       Booking[]
  comment       Comment[]
  faqs          Faq[]
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  mainImage     Media?      @relation("PackageMainImage", fields: [mainImageId], references: [id])
  map           Media?      @relation("PackageMap", fields: [mapId], references: [id])
  seo           Seo?        @relation(fields: [seoId], references: [id])
  reviews       Review[]
  wishlist      Wishlist[]
  media         Media[]     @relation("mediaPackages")

  @@index([destinationId], map: "Package_destinationId_fkey")
  @@index([mainImageId], map: "Package_mainImageId_fkey")
  @@index([mapId], map: "Package_mapId_fkey")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String?
  answer    String?
  packageId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId], map: "Faq_packageId_fkey")
}

model Booking {
  id               Int       @id @default(autoincrement())
  startDate        DateTime?
  endDate          DateTime?
  packageId        Int
  name             String?
  email            String?
  country          String?
  phone            String?
  emergency        String?
  flightArrival    String?
  flightDeparture  String?
  otherInformation String?
  status           String    @default("pending")
  paymentStatus    String    @default("unpaid")
  paymentMethod    String?
  tripCode         String?
  type             String?
  totalPrice       Int?
  price            Int?
  extraPrice       Int?
  extraDays        Int?
  extraNights      Int?
  bookingDate      DateTime?
  howdidyouhear    String?
  prePayment       Float?
  cancelReason     String?
  cancelledAt      DateTime?
  refundStatus     String?   @default("none")
  refundAmount     Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  package          Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payment          Payment?

  @@index([packageId], map: "Booking_packageId_fkey")
}

model Payment {
  id             String    @id @default(cuid())
  bookingId      Int       @unique
  status         String
  paymentMethod  String
  amount         Int
  currency       String?   @default("USD")
  transactionId  String?
  discountAmount Int?
  discountType   String?
  couponCode     String?
  paymentDate    DateTime  @default(now()) @map("payment_date")
  refundId       String?
  refundedAt     DateTime?
  refundStatus   String?   @default("none")
  refundAmount   Int?
  failureReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())
  mediaId        Int?
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  Media          Media?    @relation(fields: [mediaId], references: [id])

  @@index([mediaId], map: "payment_mediaId_fkey")
  @@map("payment")
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String?
  position  String?
  facebook  String?
  twitter   String?
  linkedin  String?
  createdAt DateTime @default(now())
  mediaId   Int?
  Media     Media?   @relation(fields: [mediaId], references: [id])

  @@index([mediaId], map: "Team_mediaId_fkey")
}

model Mail {
  id        Int      @id @default(autoincrement())
  name      String?
  phone     String?
  email     String
  message   String?  @db.MediumText
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  mediaId   Int?
  Media     Media?   @relation(fields: [mediaId], references: [id])

  @@index([mediaId], map: "Mail_mediaId_fkey")
}

model Author {
  id          Int      @id @default(autoincrement())
  name        String
  username    String
  email       String   @unique
  bio         String?
  socialLinks Json?
  website     String?
  role        String   @default("author")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mediaId     Int?
  seoId       Int?     @unique
  media       Media?   @relation(fields: [mediaId], references: [id])
  Seo         Seo?     @relation(fields: [seoId], references: [id])
  blogs       Blog[]

  @@unique([username, email])
  @@index([mediaId], map: "Author_mediaId_fkey")
}

model Comment {
  id         Int      @id @default(autoincrement())
  name       String?
  email      String
  isVerified Boolean? @default(false)
  isApproved Boolean? @default(false)
  isSpam     Boolean? @default(false)
  message    String?  @db.MediumText
  packageId  Int?
  blogId     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  blog       Blog?    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  package    Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([blogId], map: "Comment_blogId_fkey")
  @@index([packageId], map: "Comment_packageId_fkey")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int
  createdAt DateTime @default(now())
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, packageId])
  @@index([packageId], map: "wishlists_packageId_fkey")
  @@map("wishlists")
}

model Category {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  content   String   @db.LongText
  title     String?
  slug      String?  @unique
  isActive  Boolean  @default(true)
  seoId     Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seo       Seo?     @relation(fields: [seoId], references: [id])
}

enum Role {
  USER
  ADMIN
  AUTHOR
}
